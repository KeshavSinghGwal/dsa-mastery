class Solution {
    public String complexNumberMultiply(String num1, String num2) {
        String[] s1 = num1.split("\\+");
        String[] s2 = num2.split("\\+");

        int r1 = Integer.parseInt(s1[0]);
        int m1 = Integer.parseInt(s1[1].replace("i",""));
        int r2 = Integer.parseInt(s2[0]);
        int m2 = Integer.parseInt(s2[1].replace("i",""));
        int rf = r1*r2 - m1*m2 ;
        int mf = r1*m2 + m1*r2 ;
        return rf + "+" + mf + "i" ;
       
    }
}
