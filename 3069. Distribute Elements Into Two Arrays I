class Solution {
    public int[] resultArray(int[] nums) {
        int n = nums.length ;
        if(n==1 || n==2 ){
            return nums;
        }
        ArrayList<Integer> arr1 = new ArrayList<>();
        ArrayList<Integer> arr2 = new ArrayList<>();
        arr1.add(nums[0]);
        arr2.add(nums[1]);
        int l1 = nums[0];
        int l2 = nums[1];
        for(int i = 2 ; i< n ; i++){
            if(l1 >l2){
                arr1.add(nums[i]);
                l1 = nums[i];
            }else{
                arr2.add(nums[i]);
                l2= nums[i];
            }
        }

        arr1.addAll(arr2);
        int[] result = new int[n];
        for(int i = 0 ; i< n ; i++){
            result[i] = arr1.get(i);
        }
        return result ;

    }
}
