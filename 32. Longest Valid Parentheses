class Solution {
    public int longestValidParentheses(String s) {
       int n = s.length();
       
       int maxcount = 0 ;
       Stack<Integer> stack = new Stack<>();
       stack.push(-1);
       for(int i =  0 ; i<n ; i++){
          char ch = s.charAt(i);
          if(ch == '('){
             stack.push(i);
          }else{
            stack.pop();
            if(stack.isEmpty()){
                stack.push(i);
                
            }
            else{
                maxcount = Math.max(i - stack.peek(), maxcount);
                
            }
            
          }
       } 
       return maxcount ;
    }
}
