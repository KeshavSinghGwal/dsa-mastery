class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n = nums.length;

        for (int i = 0; i < n; i++) {

            int miniii = mini(i, n - 1, nums);
            int maxiii = maxi(0, i, nums);

            int score = maxiii - miniii;

            if (score <= k) {
                return i;
            }
        }

        return -1;
    }

    private int mini(int s, int l, int[] nums) {
        int smallest = nums[s];

        for (int i = s + 1; i <= l; i++) {
            smallest = Math.min(smallest, nums[i]);
        }

        return smallest;
    }

    private int maxi(int s, int l, int[] nums) {
        int largest = nums[s];

        for (int i = s + 1; i <= l; i++) {
            largest = Math.max(largest, nums[i]);
        }

        return largest;
    }
}
