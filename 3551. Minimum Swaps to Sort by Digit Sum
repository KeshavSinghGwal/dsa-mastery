class Solution {
    public int minSwaps(int[] nums) {
        int n = nums.length;
        Integer[] indices = new Integer[n];

        for (int i = 0; i < n; i++) {
            indices[i] = i;
        }

        Arrays.sort(indices, (a, b) -> {
            int sumA = compute(nums[a]);
            int sumB = compute(nums[b]);

            if (sumA != sumB) {
                return Integer.compare(sumA, sumB);
            }

            return Integer.compare(nums[a], nums[b]);
        });

        int swaps = 0;

        for (int i = 0; i < n; i++) {
            while (indices[i] != i) {
                int j = indices[i];

                int temp = indices[i];
                indices[i] = indices[j];
                indices[j] = temp;

                swaps++;
            }
        }

        return swaps;
    }

    private int compute(int x) {
        int sum = 0;

        while (x > 0) {
            sum += x % 10;
            x /= 10;
        }

        return sum;
    }
}
