class Solution {
    public String reverseParentheses(String s) {
        int n = s.length();
        int i = 0 ;
        while (i < s.length()){
            char ch = s.charAt(i);
            if(ch == ')'){
                String rev = giveString(i,s);
                int b = i-rev.length()-1;
                s = s.substring(0,b) + rev + s.substring(i+1);
                i = b ;
            }else{
                i++ ;
            }

        }
        return s ;
        
    }
    private String giveString(int j , String str){
        StringBuilder sb = new StringBuilder();
        for(int i = j-1 ; i>=0 ; i--){
            char ch = str.charAt(i);
            if(ch != '('){
                sb.append(ch);
            }
            else {
                break ;
            }
        }
        return sb.toString();
    }
}
