class Solution {
    public String[] createGrid(int m, int n) {
        char[][] arr = new char[m][n];
        for (int i = 0; i < m; i++) {
            Arrays.fill(arr[i], '#');
        }
        Arrays.fill(arr[0], '.');
        for (int i = 0; i < m; i++) {
            arr[i][n - 1] = '.';
        }
        String[] result = new String[m];

        for (int i = 0; i < m; i++) {
            result[i] = new String(arr[i]);
        }

        return result;
    }
}
