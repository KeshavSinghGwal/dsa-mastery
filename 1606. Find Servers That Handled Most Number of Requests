class Solution {
    public List<Integer> busiestServers(int k, int[] arrival, int[] load) {

        TreeSet<Integer> available = new TreeSet<>();

        // [finishTime, serverIndex]
        PriorityQueue<long[]> busy = new PriorityQueue<>(
            (a, b) -> Long.compare(a[0], b[0])
        );

        int[] count = new int[k];

        for (int i = 0; i < k; i++) {
            available.add(i);
        }

        int max = 0;

        for (int i = 0; i < arrival.length; i++) {

            int time = arrival[i];

            // Release servers that have completed their requests
            while (!busy.isEmpty() && busy.peek()[0] <= time) {

                long[] curr = busy.poll();

                available.add((int) curr[1]);
            }

            if (available.isEmpty()) {
                continue;
            }

            int preferred = i % k;

            // Find smallest available index >= preferred
            Integer server = available.ceiling(preferred);

            // Wrap around if necessary
            if (server == null) {
                server = available.first();
            }

            available.remove(server);

            count[server]++;

            max = Math.max(max, count[server]);

            // Add server to busy queue
            busy.offer(new long[]{
                (long) arrival[i] + load[i],
                server
            });
        }

        List<Integer> ans = new ArrayList<>();

        for (int i = 0; i < k; i++) {
            if (count[i] == max) {
                ans.add(i);
            }
        }

        return ans;
    }
}
