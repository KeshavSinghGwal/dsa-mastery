class Solution {
    public int sortPermutation(int[] nums) {
        int ans = 0;

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != i) {
                ans |= 0; // no operation needed
            }
        }

        boolean sorted = true;
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != i) {
                sorted = false;
                break;
            }
        }

        if (sorted) return 0;

        ans = -1;
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != i) {
                ans &= nums[i];
            }
        }

        return ans;
    }
}
