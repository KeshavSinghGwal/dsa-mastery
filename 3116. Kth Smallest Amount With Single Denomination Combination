class Solution {

    public long findKthSmallest(int[] coins, int k) {

        long left = 1;
        long right = 100000000000L; // 1e11

        while (left < right) {

            long mid = left + (right - left) / 2;

            if (count(mid, coins) >= k) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }

        return left;
    }

    private long count(long x, int[] coins) {

        int n = coins.length;
        long count = 0;

        // Every non-empty subset
        for (int mask = 1; mask < (1 << n); mask++) {

            long lcm = 1;
            boolean valid = true;
            int bits = 0;

            for (int i = 0; i < n; i++) {

                if ((mask & (1 << i)) != 0) {

                    bits++;

                    lcm = getLCM(lcm, coins[i]);

                    if (lcm > x) {
                        valid = false;
                        break;
                    }
                }
            }

            if (!valid) {
                continue;
            }

            long value = x / lcm;

            // Odd number of elements -> add
            if (bits % 2 == 1) {
                count += value;
            }
            // Even number of elements -> subtract
            else {
                count -= value;
            }
        }

        return count;
    }

    private long getLCM(long a, long b) {
        return (a / getGCD(a, b)) * b;
    }

    private long getGCD(long a, long b) {

        while (b != 0) {
            long temp = a % b;
            a = b;
            b = temp;
        }

        return a;
    }
}
