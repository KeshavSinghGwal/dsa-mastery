class Solution {
    public boolean checkValidString(String s) {
        Stack<Integer> stk = new Stack<>();
        Stack<Integer> str = new Stack<>();
        
        int n = s.length();
        for(int i = 0 ; i<n ; i++){
            char ch = s.charAt(i);
            if(ch == '(' ){
                stk.push(i);
            }
            else if(ch == '*'){
                 str.push(i);
            }else{
                if(!stk.isEmpty() ){
                    stk.pop();
                }else if(!str.isEmpty()){
                    str.pop() ;
                }
                else{
                    return false ;
                }
                
            }
        }
        while(!stk.isEmpty() && ! str.isEmpty()){
            if(stk.peek()<str.peek()){
                stk.pop();
                str.pop();
            }else{
                return false ;
            }
        }
        return stk.isEmpty();
    }
}
