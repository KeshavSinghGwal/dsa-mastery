class Solution {
    public int findTheDistanceValue(int[] arr1, int[] arr2, int d) {
        int n1 = arr1.length ;
        int n2 = arr2.length ;
        int ans = 0 ;
        for(int i= 0 ; i<n1 ; i++ ){
            int x = arr1[i] ;
            int count = 0 ;
            for(int j = 0 ; j<n2 ; j++){
                int y = arr2[j];
                if(Math.abs(x-y)<= d){
                    count++ ;
                    break;
                }
            }
            if(count ==0){
                ans++ ;
            }
        }
        return ans ;
    }
}
