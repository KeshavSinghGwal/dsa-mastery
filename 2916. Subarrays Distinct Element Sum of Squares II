
import java.util.*;

class Solution {
    static final int MOD = 1_000_000_007;

    public int sumCounts(int[] nums) {
        int n = nums.length;
        long ans = 0;

        SegmentTree seg = new SegmentTree(n);
        Map<Integer, Integer> last = new HashMap<>();

        for (int i = 0; i < n; i++) {
            int x = nums[i]; // Fixed

            int prev = last.getOrDefault(x, -1);

            seg.update(prev + 1, i, 1);

            ans = (ans + seg.query(0, i)) % MOD;

            last.put(x, i);
        }

        return (int) ans;
    }

    static class SegmentTree {
        int n;
        long[] sum;
        long[] sq;
        long[] lazy;

        SegmentTree(int n) {
            this.n = n;
            sum = new long[4 * n];
            sq = new long[4 * n];
            lazy = new long[4 * n];
        }

        void apply(int node, int l, int r, long v) {
            long len = r - l + 1L;

            sq[node] = (sq[node]
                    + 2 * v % MOD * sum[node] % MOD
                    + v * v % MOD * len % MOD) % MOD;

            sum[node] = (sum[node] + v * len) % MOD;
            lazy[node] = (lazy[node] + v) % MOD;
        }

        void push(int node, int l, int r) {
            if (lazy[node] == 0 || l == r) {
                return;
            }

            int mid = (l + r) / 2;

            apply(node * 2, l, mid, lazy[node]);
            apply(node * 2 + 1, mid + 1, r, lazy[node]);

            lazy[node] = 0;
        }

        void update(int node, int l, int r,
                    int ql, int qr, long v) {
            if (ql <= l && r <= qr) {
                apply(node, l, r, v);
                return;
            }

            push(node, l, r);
            int mid = (l + r) / 2;

            if (ql <= mid) {
                update(node * 2, l, mid, ql, qr, v);
            }

            if (qr > mid) {
                update(node * 2 + 1, mid + 1, r, ql, qr, v);
            }

            sum[node] =
                (sum[node * 2] + sum[node * 2 + 1]) % MOD;

            sq[node] =
                (sq[node * 2] + sq[node * 2 + 1]) % MOD;
        }

        long query(int node, int l, int r,
                   int ql, int qr) {
            if (ql <= l && r <= qr) {
                return sq[node];
            }

            push(node, l, r);
            int mid = (l + r) / 2;
            long result = 0;

            if (ql <= mid) {
                result += query(node * 2, l, mid, ql, qr);
            }

            if (qr > mid) {
                result += query(node * 2 + 1, mid + 1, r, ql, qr);
            }

            return result % MOD;
        }

        void update(int l, int r, long v) {
            update(1, 0, n - 1, l, r, v);
        }

        long query(int l, int r) {
            return query(1, 0, n - 1, l, r);
        }
    }
}
