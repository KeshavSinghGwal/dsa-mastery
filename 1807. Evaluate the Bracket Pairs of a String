class Solution {
    public String evaluate(String s, List<List<String>> knowledge) {
        int n = s.length() ;
        StringBuilder sb = new StringBuilder();
        HashMap<String, String> map = new HashMap<>();

        for (List<String> list : knowledge) {
            map.put(list.get(0), list.get(1));
        }
        for(int i =  0 ; i< n ; i++){
            char ch = s.charAt(i);
            if(ch == '('){
                String curr = giveString(i+1 , s);
                i = i+ curr.length() +1;
                String man = map.getOrDefault(curr, "?");

                sb.append(man);

            }
            else{
                sb.append(ch); 
            }
        }
        return sb.toString();
    }
    private String giveString(int j , String str){
        StringBuilder sb = new StringBuilder();
        for(int i = j ; i< str.length() ; i++){
            char ch = str.charAt(i);
            if(ch != ')'){
                sb.append(ch);
            }
            else {
                break ;
            }
        }
        return sb.toString();
    }
    
}
