class Solution {
    public long countCommas(long n) {

        long ans = 0;
        long start = 1_000;
        long commas = 1;

        while (start <= n) {

            long end = start * 1000 - 1;

            long count = Math.min(n, end) - start + 1;

            ans += count * commas;

            start *= 1000;
            commas++;
        }

        return ans;
    }
}
