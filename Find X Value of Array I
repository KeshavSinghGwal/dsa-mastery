class Solution {
    public long[] resultArray(int[] nums, int k) {
        long[] result = new long[k];
        long[] cnt = new long[k];
        for (int num : nums) {
            int a = num % k;
            long[] next = new long[k];
            for (int r = 0; r < k; r++) {
                if (cnt[r] > 0) {
                    next[(r * a) % k] += cnt[r];
                }
            }

            next[a]++;

            for (int r = 0; r < k; r++) {
                result[r] += next[r];
            }

            cnt = next;
        }

        return result;
    }
}
