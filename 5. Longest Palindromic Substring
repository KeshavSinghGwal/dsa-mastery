class Solution {
    public String longestPalindrome(String s) {
        int n = s.length();
        int t = 0 ;
        String curr ="";
        for(int i = 0 ; i<n ; i++){
           for(int j = i ;j<n ; j++){
               String sub = s.substring(i, j+1);
               if(ispal(sub)){
                  if(j-i+1>t){
                     t = j - i + 1;;
                     curr = sub ;
                  }
               }
           }
        }
        return curr ;
    }
    private boolean ispal(String str ){
        int n = str.length();
        int l = 0 ; 
        int r = n-1;
        
        while (l < r) {

            if (str.charAt(l) != str.charAt(r)) {
                return false;
            }

            l++;
            r--;
        }

        return true;
    }
}
