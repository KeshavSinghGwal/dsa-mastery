class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int n = nums.length ;
        int len1 = 1 ;
        int len2 = 1 ;
        int max = 1 ;
        for(int i = 1 ; i<n ; i++){
            if(nums[i]> nums[i-1]){
                len1++;
            }else{
                len1 = 1 ;
            }

            if(nums[i]< nums[i-1]){
                len2++ ;
            }else {
                len2 = 1 ;
            }

            max = Math.max(max , Math.max(len1 , len2 ));
        }
        return max ;
    }
    
    
}
