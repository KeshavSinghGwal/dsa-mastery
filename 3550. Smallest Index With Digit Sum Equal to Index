class Solution {
    public int smallestIndex(int[] nums) {
        for(int i = 0 ; i<nums.length ; i++){
            int x = nums[i];
            int tar = 0 ;
            while(x>9){
                tar += x%10;
                x= x/10;
            }
            tar += x ;
            if(tar == i){
                return i ;
            }
        }
        return -1;
    }
}
